{
  "worldFormat": 1,
  "paths": ["req/**", "findings/**", "board/**", "poc/**/*.md", "poc/results/**", "proposal/**", "plan/**", "brief/**", "notes/**", "journals/**", "ideas/**", "inputs/**"],
  "defaultKind": { "board/**": "editorial" },
  "reproduce": [{ "glob": "poc/results/**", "for": "tester" }],
  "command": ["req/**"],
  "proposal": ["ideas/**"],
  "information": ["inputs/**"],
  "tags": ["requirements", "technology", "market", "internal", "area-a", "area-b", "test", "plan"],
  "intake": { "folder": "inputs/intake", "model": "haiku", "perSourceHour": 30, "usdDay": 1, "sources": [] },
  "derived": {
    "businessplan": { "paths": ["plan/business-plan.md"], "owner": "planner", "debounceMin": 30 },
    "proposal": { "paths": ["proposal/**"], "owner": "integrator", "debounceMin": 30 },
    "gaps": { "paths": ["notes/gaps.md"], "owner": "requirements", "debounceMin": 30 }
  },
  "commit": { "everyMin": 60 },
  "code": {
    "repo": { "kind": "git", "path": ".", "upstream": "main", "everyMin": 5 },
    "depot": { "off": true, "kind": "p4", "host": "dev.example.invalid", "depot": "//depot/project/...", "everyMin": 5 }
  },
  "proofs": { "paths": ["findings/**/*.md", "poc/results/**/*.md"], "kinds": ["finding", "result"], "rerun": [], "timeoutS": 30 },
  "checks": [{ "name": "proofs", "glob": "{findings,poc/results}/**/*.md", "argv": ["python3", ".claude/fleet/checks/proof-check.py", "--budget", "100"], "timeoutMs": 120000 }],
  "judges": { "model": "haiku", "hold": ["\\b(spend\\w*|spent|pric\\w*|pay|paid|payments?|invoic\\w*|purchas\\w*|refund\\w*|dollars?|euros?|usd|eur)\\b|[$€£]\\s?\\d|\\d\\s?[$€£]"], "statute": ["CLAUDE.md", ".claude/rules/*.md"], "reviewer": "Chief" }
}
